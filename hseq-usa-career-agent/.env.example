# Copy to .env.local and fill in. Never commit .env.local.
#
# Local stack: run `npx supabase start`, then `npx supabase status -o env`
# Cloud: Supabase dashboard → Project Settings → API

# Public — safe in the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-side scripts and tests only. Bypasses RLS.
# Never prefix with NEXT_PUBLIC_, never import from client code.
SUPABASE_SERVICE_ROLE_KEY=
